@baseUrl = http://localhost:3000
@contentType = application/json

# Credenciais do usuário de teste
@userEmail = user@example.com
@userPassword = password123

# Tokens capturados automaticamente dos responses de login/refresh
# (preenchidos pelo REST Client via @name + response variables)
@accessToken = {{login.response.body.$.access_token}}
@refreshToken = {{login.response.body.$.refresh_token}}

# Tokens obtidos via e-mail — preencher manualmente após consultar http://localhost:8025
@confirmationToken = <token do e-mail de confirmacao>
@resetToken = <token do e-mail de reset>


###
# ─────────────────────────────────────────────
# HEALTH CHECK
# ─────────────────────────────────────────────

### GET / — verifica se a API está no ar
GET {{baseUrl}}/


###
# ─────────────────────────────────────────────
# REGISTRO E CONFIRMAÇÃO DE EMAIL
# ─────────────────────────────────────────────

### 1. Registrar novo usuário
# Após o registro, consulte http://localhost:8025 para obter o token de confirmação
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}


### 2. Confirmar email com token recebido
# Cole o token do e-mail em @confirmationToken acima
GET {{baseUrl}}/auth/confirm-email?token={{confirmationToken}}

### 3. Reenviar email de confirmação
POST {{baseUrl}}/auth/resend-confirmation
Content-Type: {{contentType}}

{
  "email": "{{userEmail}}"
}


###
# ─────────────────────────────────────────────
# LOGIN E TOKENS
# ─────────────────────────────────────────────

### 4. Login — access_token e refresh_token capturados automaticamente
# @name login
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}


### 5. Renovar tokens — access_token e refresh_token atualizados automaticamente
# @name login
POST {{baseUrl}}/auth/refresh
Content-Type: {{contentType}}

{
  "refresh_token": "{{refreshToken}}"
}


###
# ─────────────────────────────────────────────
# USUÁRIO AUTENTICADO
# ─────────────────────────────────────────────

### 6. Dados do usuário autenticado
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}


### 7. Logout — revoga todos os refresh tokens do usuário
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{accessToken}}


###
# ─────────────────────────────────────────────
# RECUPERAÇÃO DE SENHA
# ─────────────────────────────────────────────

### 8. Solicitar redefinição de senha
# Após a solicitação, consulte http://localhost:8025 para obter o token de reset
POST {{baseUrl}}/auth/forgot-password
Content-Type: {{contentType}}

{
  "email": "{{userEmail}}"
}


### 9. Redefinir senha com token recebido
# Cole o token do e-mail em @resetToken acima
POST {{baseUrl}}/auth/reset-password
Content-Type: {{contentType}}

{
  "token": "{{resetToken}}",
  "new_password": "new-password123"
}


###
# ─────────────────────────────────────────────
# VÍDEOS — UPLOAD (dono do canal, requer login)
# Fluxo: iniciar → pedir URLs das partes → PUT de cada parte direto no storage
#        → concluir → acompanhar o processamento
# ─────────────────────────────────────────────

@videoId = {{initiateUpload.response.body.$.id}}
@videoPublicId = {{initiateUpload.response.body.$.public_id}}

### POST /videos — inicia o upload (pré-cadastra o vídeo como rascunho)
# size em bytes (máx. 10GB = 10737418240). A resposta traz part_size e part_count.
# @name initiateUpload
POST {{baseUrl}}/videos
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "filename": "meu-video.mp4",
  "content_type": "video/mp4",
  "size": 1048576
}

### POST /videos/:id/upload/part-urls — URLs pré-assinadas (até 100 partes por chamada)
# Envie os bytes de cada parte com PUT na URL retornada e guarde o header ETag da resposta:
#   curl -X PUT --data-binary @parte1.bin "<url>" -i
# @name partUrls
POST {{baseUrl}}/videos/{{videoId}}/upload/part-urls
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "part_numbers": [1]
}

### GET /videos/:id/upload/parts — partes já recebidas pelo storage (retomada)
GET {{baseUrl}}/videos/{{videoId}}/upload/parts
Authorization: Bearer {{accessToken}}

### POST /videos/:id/upload/complete — conclui o upload e dispara o processamento
# Substitua o etag pelo valor devolvido pelo storage no PUT da parte (com as aspas).
POST {{baseUrl}}/videos/{{videoId}}/upload/complete
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "parts": [
    { "part_number": 1, "etag": "\"<etag devolvido pelo storage>\"" }
  ]
}

### GET /videos/:id/upload — estado do vídeo (draft → processing → ready | failed)
GET {{baseUrl}}/videos/{{videoId}}/upload
Authorization: Bearer {{accessToken}}

### DELETE /videos/:id/upload — aborta um upload em andamento e remove o rascunho
DELETE {{baseUrl}}/videos/{{videoId}}/upload
Authorization: Bearer {{accessToken}}


###
# ─────────────────────────────────────────────
# VÍDEOS — ACESSO PÚBLICO PELA URL ÚNICA (somente vídeos "ready")
# ─────────────────────────────────────────────

### GET /videos/:publicId — detalhes (duração, metadados, canal)
GET {{baseUrl}}/videos/{{videoPublicId}}

### GET /videos/:publicId/stream — 302 para URL pré-assinada (o storage responde Range/206)
# Para ver o 206: curl -L -H "Range: bytes=0-99" -o /dev/null -D - {{baseUrl}}/videos/<publicId>/stream
# @no-redirect
GET {{baseUrl}}/videos/{{videoPublicId}}/stream

### GET /videos/:publicId/download — 302 para URL pré-assinada com Content-Disposition: attachment
# @no-redirect
GET {{baseUrl}}/videos/{{videoPublicId}}/download

### GET /videos/:publicId/thumbnail — 302 para o JPEG gerado no processamento
# @no-redirect
GET {{baseUrl}}/videos/{{videoPublicId}}/thumbnail
